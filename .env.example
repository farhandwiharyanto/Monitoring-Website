# --- Docker Compose ---
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch
POSTGRES_DB=pulsewatch

# WAJIB diganti di production: minimal 32 karakter acak, mis. `openssl rand -hex 32`.
# Server menolak start bila nilainya masih bawaan saat NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
BASE_URL=http://localhost:3001
TZ=Asia/Jakarta

# --- Opsional: keamanan ---
# Umur token login (format zeit/ms: 15m, 12h, 7d)
# JWT_TTL=7d
# Aktifkan bila berada di belakang reverse proxy, supaya rate limit membaca X-Forwarded-For
# TRUST_PROXY=true
# Origin tambahan yang boleh memanggil API (dipisah koma). Default: BASE_URL saja.
# CORS_ORIGINS=https://status.domain.com
# Rate limit login
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SECONDS=300
# LOGIN_LOCK_SECONDS=900

# --- Opsional: monitoring ---
# Ambang peringatan sertifikat TLS (hari). Satu alert per ambang yang dilewati.
# CERT_ALERT_THRESHOLDS=30,14,7,3
# Jeda antar pemeriksaan sertifikat (handshake TLS tidak perlu tiap interval)
# CERT_CHECK_INTERVAL_HOURS=6
# Ambang badge "segera kedaluwarsa" di UI (hari)
# CERT_EXPIRY_WARN_DAYS=14
# Heartbeat lebih tua dari ini dihapus tiap hari jam 03:00
# HEARTBEAT_RETENTION_DAYS=90

# --- Opsional: multi-location ---
# Nama lokasi instance ini; jadi label pada setiap heartbeat yang ditulisnya
# LOCATION_NAME=primary
# Lokasi acuan untuk status, uptime, incident, dan alert
# PRIMARY_LOCATION=primary
# Worker lokasi kedua: hanya scheduler, tanpa API/UI
# WORKER_ONLY=false
# Nama lokasi untuk service pulsewatch-worker di docker-compose
# WORKER_LOCATION_NAME=singapore

# --- Opsional: Prometheus ---
# Token scrape untuk /metrics. Kosong = hanya token login yang diterima.
# METRICS_TOKEN=
# Buka /metrics tanpa auth (hanya bila sudah dibatasi di level jaringan)
# METRICS_PUBLIC=false

# --- Opsional: API key ---
# Rate limit per API key
# API_KEY_RATE_LIMIT=60
# API_KEY_RATE_WINDOW_SECONDS=60

# --- Opsional: webhook aksi ---
# Percobaan pemanggilan webhook aksi (termasuk percobaan pertama)
# ACTION_WEBHOOK_ATTEMPTS=3
# ACTION_WEBHOOK_TIMEOUT_SECONDS=15

# --- Opsional: laporan SLA ---
# Downtime saat maintenance window aktif tidak dihitung melanggar SLA.
# SLA_EXCLUDE_MAINTENANCE=true
# Target SLO bawaan untuk monitor baru (persen). Kosong = tanpa target.
# SLO_DEFAULT_TARGET=99.9

# --- Opsional: audit log ---
# Berapa lama jejak perubahan konfigurasi & akses disimpan (hari).
# Dibersihkan otomatis bersama heartbeat, tiap hari jam 03:00.
# AUDIT_RETENTION_DAYS=365

# --- Opsional: enkripsi kredensial monitor ---
# Kunci enkripsi Basic Auth / Bearer token milik monitor. Bila kosong,
# diturunkan dari JWT_SECRET — maka mengganti JWT_SECRET membuat kredensial
# monitor yang tersimpan tidak terbaca dan harus diisi ulang.
# Worker multi-location harus memakai nilai yang sama dengan instance web.
# ENCRYPTION_KEY=

# --- Opsional: riwayat pengiriman notifikasi ---
# Berapa lama riwayat kirim (berhasil & gagal) disimpan. Dibersihkan otomatis
# bersama heartbeat dan audit log, tiap hari jam 03:00.
# NOTIFICATION_LOG_RETENTION_DAYS=30

# --- Opsional: lease scheduler & shutdown ---
# Hanya satu proses per LOCATION_NAME yang menjalankan check. Kepemimpinannya
# dipegang lewat lease di database dan diperpanjang berkala, sehingga replika
# atau container baru saat deploy tidak meng-check (dan mengirim alert) dobel.
# Masa berlaku lease sejak perpanjangan terakhir (detik). Makin pendek, makin
# cepat proses pengganti mengambil alih bila pemegangnya mati mendadak.
# SCHEDULER_LEASE_SECONDS=30
# Jarak antar perpanjangan (detik). Harus jauh lebih kecil dari masa berlaku.
# SCHEDULER_LEASE_RENEW_SECONDS=10
# Batas waktu berhenti dengan rapi sebelum proses dipaksa keluar (detik).
# SHUTDOWN_TIMEOUT_SECONDS=15

# --- Development lokal (server/.env) ---
# PORT=3001
# DATABASE_URL=postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch
