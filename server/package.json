{
  "name": "pulsewatch-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "migrate:sqlite": "node scripts/migrate-from-sqlite.js",
    "test": "node --import ./test-setup.mjs --test test/*.test.js",
    "test:db": "node --import ./test-setup.mjs --test --test-concurrency=1 test-db/*.test.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
