// Pulsewatch — PostgreSQL schema
// Nama field sengaja snake_case agar bentuk JSON API tetap sama dengan versi SQLite.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique
  password_hash       String
  role                String   @default("admin") // admin | viewer
  // Token yang diterbitkan sebelum waktu ini dianggap batal (dipakai saat ganti password)
  password_changed_at DateTime @default(now())
  created_at          DateTime @default(now())

  // 2FA (TOTP). Secret disimpan terenkripsi seperti kredensial monitor; kode
  // cadangan hanya hash-nya. totp_last_step mencegah satu kode dipakai dua kali.
  totp_secret         String?
  totp_enabled        Boolean  @default(false)
  totp_recovery       Json?
  totp_last_step      Int?

  // Kontak pribadi untuk paging on-call (mis. Telegram/ntfy miliknya sendiri).
  // Dipakai saat langkah eskalasi menunjuk jadwal rotasi, bukan channel tim.
  oncall_notification_id Int?
  oncall_notification    Notification? @relation("OnCallContact", fields: [oncall_notification_id], references: [id], onDelete: SetNull)

  oncall_shifts OnCallShift[]

  @@map("users")
}

model Monitor {
  id                    Int      @id @default(autoincrement())
  name                  String
  type                  String   @default("http") // http | tcp | ping | dns | push
  url                   String?
  hostname              String?
  port                  Int?
  dns_resolve_type      String?  @default("A")
  dns_expected          String?
  method                String   @default("GET")
  interval_seconds      Int      @default(60)
  timeout_seconds       Int      @default(30)
  max_retries           Int      @default(0)
  expected_status_codes String   @default("200-299")
  keyword               String?
  active                Boolean  @default(true)

  // Monitor tipe `push`: target mengirim heartbeat ke /api/push/<token>.
  // Dianggap down bila tidak ada heartbeat melewati grace period.
  push_token            String?  @unique
  push_grace_seconds    Int      @default(60)

  // Sertifikat TLS (monitor https): diisi otomatis saat check
  check_cert            Boolean   @default(true)
  cert_expires_at       DateTime?
  cert_issuer           String?
  cert_subject          String?
  cert_checked_at       DateTime?
  // Hasil validasi rantai sertifikat pada pemeriksaan terakhir
  cert_chain_valid      Boolean?
  cert_chain_error      String?
  // Ambang peringatan terkecil yang sudah dikirim (30/14/7/3) supaya tidak spam.
  // Direset ke null saat sertifikat diperbarui.
  cert_notified_threshold Int?

  // HTTP check lanjutan
  http_headers          Json?     // { "X-Api-Key": "…" } — dikirim apa adanya
  auth_type             String    @default("none") // none | basic | bearer
  // Kredensial auth disimpan terenkripsi (AES-256-GCM), bukan plaintext
  auth_secret           String?
  // Assertion terhadap body JSON: assertion_path + operator + value
  assertion_path        String?   // mis. $.status atau $.data.items[0].id
  assertion_operator    String?   // eq | ne | gt | lt | gte | lte | contains | exists
  assertion_value       String?

  // Webhook automation: dipanggil untuk memicu aksi di sistem lain
  // (restart service, buka ticket). Berbeda dari notifikasi yang sekadar memberi kabar.
  action_webhook_url     String?
  action_webhook_method  String   @default("POST") // POST | GET | PUT
  action_webhook_headers Json?
  action_on_down         Boolean  @default(true)
  action_on_recover      Boolean  @default(false)

  // Target SLO dalam persen (mis. 99.9). null = monitor ini tidak punya target,
  // uptime-nya tetap dilaporkan tapi tanpa error budget.
  slo_target            Float?

  // Ambang waktu respons (ms). Di atas ini monitor dianggap "degraded": masih
  // hidup, tapi lebih lambat dari yang dijanjikan. null = tidak dinilai.
  // Status heartbeat-nya tetap UP, jadi uptime & SLA tidak ikut berubah.
  latency_threshold_ms  Int?

  // Connection string untuk monitor database (postgres/mysql/redis), disimpan
  // terenkripsi seperti kredensial HTTP — isinya hampir selalu memuat password.
  conn_secret           String?
  // Opsi khusus per tipe check yang BUKAN rahasia: query yang dijalankan, nama
  // service gRPC, topik Kafka. Satu kolom JSON supaya tipe check berikutnya
  // tidak menambah kolom lagi.
  check_config          Json?

  // Jeda pengingat selama monitor masih down (menit). null = tidak mengingatkan.
  // Berbeda dari eskalasi: eskalasi memanggil orang lain secara berjenjang,
  // ini hanya mengulang kabar ke channel yang sama supaya gangguan panjang
  // tidak terlupakan setelah pesan pertamanya tenggelam.
  renotify_minutes      Int?

  // Dependency antar-monitor: monitor induk (mis. router/gateway di depan
  // layanan ini). Selama induk down, alert & webhook aksi monitor ini ditahan
  // supaya satu gangguan di lapisan bawah tidak membanjiri notifikasi.
  parent_id             Int?

  // Escalation policy yang dipakai saat monitor ini down. null = pakai policy
  // yang ditandai default; kalau tidak ada juga, monitor ini tidak dieskalasi
  // dan hanya mengirim notifikasi biasa seperti sebelumnya.
  escalation_policy_id  Int?

  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt

  // Induk dihapus -> anak jadi mandiri lagi (SetNull), bukan ikut terhapus
  parent   Monitor?  @relation("MonitorDependency", fields: [parent_id], references: [id], onDelete: SetNull)
  children Monitor[] @relation("MonitorDependency")

  // Policy dihapus -> monitor kembali memakai policy default (SetNull)
  escalation_policy EscalationPolicy? @relation(fields: [escalation_policy_id], references: [id], onDelete: SetNull)
  escalations       Escalation[]

  heartbeats    Heartbeat[]
  incidents     Incident[]
  notifications MonitorNotification[]
  status_pages  StatusPageMonitor[]
  tags          MonitorTag[]
  maintenance   MaintenanceWindow[]
  events        MonitorEvent[]
  webhook_logs  WebhookLog[]

  @@index([parent_id])
  @@index([escalation_policy_id])
  @@map("monitors")
}

model Heartbeat {
  id            Int      @id @default(autoincrement())
  monitor_id    Int
  status        Int      // 0 down, 1 up, 2 pending
  message       String?
  response_time Int?
  important     Boolean  @default(false) // true jika status berubah up<->down atau masuk/keluar degraded
  maintenance   Boolean  @default(false) // dicatat saat monitor dalam maintenance window
  // Respons melewati latency_threshold_ms monitor. Heartbeat-nya tetap UP:
  // penanda ini soal kualitas, bukan ketersediaan.
  degraded      Boolean  @default(false)
  // Lokasi agen yang melakukan check. null = baris lama dari sebelum
  // multi-location; diperlakukan sama dengan lokasi primary.
  location      String?
  // Hasil body assertion (null = monitor ini tidak memakai assertion)
  assertion_ok      Boolean?
  assertion_message String?
  created_at    DateTime @default(now())

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@index([monitor_id, created_at(sort: Desc)])
  @@index([monitor_id, location, created_at(sort: Desc)])
  @@map("heartbeats")
}

model Incident {
  id          Int       @id @default(autoincrement())
  monitor_id  Int
  started_at  DateTime  @default(now())
  resolved_at DateTime?
  cause       String?
  maintenance Boolean   @default(false) // down terjadi saat maintenance
  notified    Boolean   @default(false) // alert "down" sudah terkirim
  // Kabar terakhir soal incident ini (alert pertama maupun pengingat), dan
  // sudah berapa kali diingatkan. Dasar perhitungan pengingat berikutnya.
  last_notified_at DateTime?
  renotify_count   Int      @default(0)
  // Alert ditahan karena monitor induk sedang down. Tetap dicatat sebagai
  // incident supaya riwayat & uptime tidak berubah, hanya alert-nya yang diam.
  suppressed       Boolean @default(false)
  suppressed_by_id Int?    // id monitor induk yang menahan, untuk ditampilkan di UI

  monitor    Monitor          @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  updates    IncidentUpdate[]
  events     MonitorEvent[]
  escalation Escalation?

  @@index([monitor_id, started_at(sort: Desc)])
  @@index([resolved_at, last_notified_at])
  @@map("incidents")
}

// Kabar manual dari admin selama incident berlangsung — tampil di status page
// publik supaya pengguna tahu perkembangannya tanpa melihat detail teknis.
model IncidentUpdate {
  id          Int      @id @default(autoincrement())
  incident_id Int
  status      String   @default("investigating") // investigating | identified | monitoring | resolved
  message     String
  author      String?  // username penulis saat dibuat
  created_at  DateTime @default(now())

  incident Incident @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@index([incident_id, created_at(sort: Desc)])
  @@map("incident_updates")
}

// Event non-heartbeat pada timeline monitor: laporan otomasi dari sistem luar
// (Ansible/n8n lewat webhook inbound) maupun catatan manual.
model MonitorEvent {
  id          Int      @id @default(autoincrement())
  monitor_id  Int
  incident_id Int?     // incident yang sedang terbuka saat event masuk, bila ada
  kind        String   @default("automation") // automation | note
  source      String?  // mis. "ansible", "n8n"
  title       String
  message     String?
  payload     Json?    // body asli dari pemanggil, untuk penelusuran
  created_at  DateTime @default(now())

  monitor  Monitor   @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incident_id], references: [id], onDelete: SetNull)

  @@index([monitor_id, created_at(sort: Desc)])
  @@map("monitor_events")
}

// Riwayat pemanggilan webhook automation, termasuk percobaan yang gagal
model WebhookLog {
  id          Int      @id @default(autoincrement())
  monitor_id  Int
  incident_id Int?
  event       String   // down | recover
  url         String
  method      String
  attempt     Int      @default(1)
  ok          Boolean  @default(false)
  status_code Int?
  error       String?
  duration_ms Int?
  created_at  DateTime @default(now())

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@index([monitor_id, created_at(sort: Desc)])
  @@map("webhook_logs")
}

// Kunci akses programatik. Hanya hash yang disimpan; nilai aslinya
// ditampilkan sekali saat dibuat.
model ApiKey {
  id           Int       @id @default(autoincrement())
  label        String
  // SHA-256 dari kunci penuh. Kunci punya entropi 256 bit sehingga hash cepat sudah memadai.
  key_hash     String    @unique
  // Potongan awal kunci untuk ditampilkan di daftar, mis. "pw_ab12cd34"
  prefix       String
  scope        String    @default("read") // read | write
  created_by   String?
  last_used_at DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  @@index([revoked_at])
  @@map("api_keys")
}

model Notification {
  id         Int      @id @default(autoincrement())
  name       String
  type       String   // telegram | discord | email | webhook | slack | googlechat | ntfy
  config     Json     @default("{}")
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  monitors          MonitorNotification[]
  escalation_steps  EscalationStep[]
  oncall_contact_of User[]               @relation("OnCallContact")

  @@map("notifications")
}

model MonitorNotification {
  monitor_id      Int
  notification_id Int

  monitor      Monitor      @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@id([monitor_id, notification_id])
  @@map("monitor_notifications")
}

model StatusPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String?
  published   Boolean  @default(true)

  // Kustomisasi tampilan halaman publik
  logo_url     String?
  accent_color String  @default("#38bdf8")
  theme        String  @default("dark") // dark | light | auto
  show_uptime  Boolean @default(true)
  show_bars    Boolean @default(true)
  show_incidents Boolean @default(true)
  footer_text  String?
  // Pengumuman/banner incident yang ditulis manual oleh admin
  announcement       String?
  announcement_style String  @default("info") // info | warning | critical
  // Domain khusus (opsional): halaman juga bisa dibuka lewat host ini
  custom_domain String? @unique

  created_at  DateTime @default(now())

  monitors StatusPageMonitor[]
  tags     StatusPageTag[]

  @@map("status_pages")
}

// Status page bisa memilih monitor lewat tag/group, bukan satu per satu.
// Monitor yang dipilih langsung dan lewat tag digabung.
model StatusPageTag {
  status_page_id Int
  tag_id         Int

  status_page StatusPage @relation(fields: [status_page_id], references: [id], onDelete: Cascade)
  tag         Tag        @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([status_page_id, tag_id])
  @@map("status_page_tags")
}

// Pengaturan global aplikasi (key/value) — mis. bahasa & tema default
model Setting {
  key        String   @id
  value      Json     @default("{}")
  updated_at DateTime @default(now()) @updatedAt

  @@map("settings")
}

model StatusPageMonitor {
  status_page_id Int
  monitor_id     Int
  sort_order     Int @default(0)

  status_page StatusPage @relation(fields: [status_page_id], references: [id], onDelete: Cascade)
  monitor     Monitor    @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@id([status_page_id, monitor_id])
  @@map("status_page_monitors")
}

model Tag {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  color      String   @default("#38bdf8")
  created_at DateTime @default(now())

  monitors     MonitorTag[]
  status_pages StatusPageTag[]

  @@map("tags")
}

model MonitorTag {
  monitor_id Int
  tag_id     Int

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([monitor_id, tag_id])
  @@map("monitor_tags")
}

// recurring: none | daily | weekly. Untuk recurring, start_at/end_at menentukan
// jam mulai & durasi; days_of_week (weekly) berisi "0,1,..,6" (0 = Minggu).
model MaintenanceWindow {
  id           Int      @id @default(autoincrement())
  monitor_id   Int
  title        String
  start_at     DateTime
  end_at       DateTime
  recurring    String   @default("none")
  days_of_week String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@index([monitor_id])
  @@map("maintenance_windows")
}

// Jejak perubahan konfigurasi & akses. Ditulis dari route, bukan dari trigger DB,
// supaya ikut mencatat siapa pelakunya (user login maupun API key) dan dari IP mana.
// Isinya hanya dibaca — tidak ada endpoint untuk mengubah atau menghapus satu baris.
model AuditLog {
  id          Int      @id @default(autoincrement())
  actor_id    Int?     // id user; null untuk API key atau tindakan sistem
  actor       String   // username, "apikey:<label>", atau "sistem"
  actor_type  String   @default("user") // user | apikey | system
  action      String   // mis. monitor.update, user.delete, auth.login
  entity      String   // monitor | notification | user | api_key | status_page | ...
  entity_id   Int?
  entity_name String?  // nama saat kejadian, tetap terbaca walau entitasnya dihapus
  summary     String?  // ringkasan sebaris untuk daftar
  // { field: { from, to } } — nilai rahasia sudah ditopeng sebelum disimpan
  changes     Json?
  ip          String?
  created_at  DateTime @default(now())

  @@index([created_at(sort: Desc)])
  @@index([entity, entity_id, created_at(sort: Desc)])
  @@index([actor, created_at(sort: Desc)])
  @@map("audit_logs")
}

// --- Phase 7: on-call & eskalasi ---

// Jadwal rotasi: wadah bagi sekumpulan shift. Modelnya sengaja "shift bebas"
// bukan rotasi mingguan yang dihitung otomatis, supaya tukar jaga dan libur
// sehari cukup mengubah satu baris, bukan menggeser urutan seluruh tim.
model OnCallSchedule {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  // Zona waktu untuk menampilkan & mengisi shift di UI. Nilai yang disimpan
  // tetap UTC seperti kolom waktu lain; ini hanya memengaruhi tampilan.
  timezone    String   @default("Asia/Jakarta")
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  shifts OnCallShift[]
  steps  EscalationStep[]

  @@map("oncall_schedules")
}

// Satu giliran jaga: siapa, dari kapan sampai kapan. Shift boleh bertumpang
// tindih; yang dianggap bertugas adalah shift dengan start_at paling akhir yang
// mencakup saat itu, sehingga shift pengganti cukup dibuat belakangan.
model OnCallShift {
  id          Int      @id @default(autoincrement())
  schedule_id Int
  user_id     Int
  start_at    DateTime
  end_at      DateTime
  note        String?
  created_at  DateTime @default(now())

  schedule OnCallSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, start_at])
  @@index([schedule_id, end_at])
  @@map("oncall_shifts")
}

// Aturan eskalasi: urutan langkah beserta jedanya. Dipasang per monitor, atau
// ditandai default supaya berlaku untuk monitor yang tidak memilih sendiri.
model EscalationPolicy {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  is_default  Boolean  @default(false)
  active      Boolean  @default(true)
  // Setelah tingkat terakhir lewat tanpa ada yang menangani, seluruh rantai
  // diulang sebanyak repeat_times kali, tiap putaran repeat_minutes kemudian.
  repeat_times   Int   @default(0)
  repeat_minutes Int   @default(15)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  steps       EscalationStep[]
  monitors    Monitor[]
  escalations Escalation[]

  @@map("escalation_policies")
}

// Satu tingkat eskalasi: setelah `delay_minutes` sejak incident mulai, kabari
// sasaran ini. Sasaran selalu notifikasi yang sudah ada — lewat jadwal on-call
// (kontak pribadi orang yang sedang bertugas) atau channel tertentu langsung.
model EscalationStep {
  id              Int    @id @default(autoincrement())
  policy_id       Int
  step_order      Int    @default(0)
  delay_minutes   Int    @default(0) // 0 = dikirim saat incident mulai
  // oncall  -> schedule_id, kontak pribadi orang yang bertugas saat itu
  // channel -> notification_id, satu notifikasi tertentu (mis. Slack tim)
  target          String @default("oncall")
  schedule_id     Int?
  notification_id Int?

  policy       EscalationPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  schedule     OnCallSchedule?  @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  notification Notification?    @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@index([policy_id, step_order])
  @@map("escalation_steps")
}

// Rantai eskalasi yang sedang/pernah berjalan untuk satu incident. Satu incident
// hanya punya satu rantai, jadi incident yang sama tidak dieskalasi dua kali.
model Escalation {
  id          Int      @id @default(autoincrement())
  incident_id Int      @unique
  monitor_id  Int
  policy_id   Int?
  started_at  DateTime @default(now())
  round       Int      @default(1) // putaran ke berapa yang sedang berjalan

  // Token untuk acknowledge dari pesan notifikasi tanpa login. Hanya berlaku
  // selama rantai belum berhenti.
  ack_token String @unique

  acknowledged_at DateTime?
  acknowledged_by String? // username, atau "tautan notifikasi" bila lewat token

  stopped_at     DateTime?
  // acknowledged | recovered | paused | resolved | exhausted
  stopped_reason String?

  incident   Incident             @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  monitor    Monitor              @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  policy     EscalationPolicy?    @relation(fields: [policy_id], references: [id], onDelete: SetNull)
  deliveries EscalationDelivery[]

  @@index([stopped_at])
  @@map("escalations")
}

// Satu langkah yang dijadwalkan untuk satu rantai. Seluruh baris dibuat sekali
// saat rantai mulai, sehingga cron cukup mencari yang `due_at` sudah lewat dan
// UI bisa menampilkan rencana lengkapnya ("15 menit lagi ke seluruh tim").
model EscalationDelivery {
  id            Int       @id @default(autoincrement())
  escalation_id Int
  step_order    Int
  round         Int       @default(1)
  delay_minutes Int
  due_at        DateTime
  // pending | sent | failed | skipped | cancelled
  status        String    @default("pending")
  sent_at       DateTime?

  // Sasaran disalin dari langkah policy saat rantai dibuat, bukan dibaca ulang
  // waktu kirim: menyunting policy karena itu tidak mengubah rantai yang sedang
  // berjalan. Sengaja tanpa foreign key — jadwal atau notifikasi yang dihapus
  // tidak boleh ikut menghapus riwayat siapa yang pernah dikabari.
  target          String  @default("oncall") // oncall | channel
  schedule_id     Int?
  // Notifikasi yang dipakai: untuk target channel sudah terisi sejak awal,
  // untuk target oncall baru diisi saat kirim (kontak orang yang bertugas).
  notification_id Int?
  // Siapa yang sebenarnya dikabari, dalam bahasa manusia. Baru diketahui saat
  // kirim, karena yang bertugas bisa berganti sebelum tingkat ini jatuh tempo.
  target_label    String?
  error           String?

  escalation Escalation @relation(fields: [escalation_id], references: [id], onDelete: Cascade)

  @@index([status, due_at])
  @@index([escalation_id, step_order])
  @@map("escalation_deliveries")
}

// Riwayat pengiriman notifikasi, termasuk percobaan yang gagal. Sebelumnya
// kegagalan kirim hanya tercetak ke stdout, jadi saluran alert yang mati —
// bot dicabut, SMTP ditolak, webhook 404 — tidak terlihat dari aplikasi sama
// sekali. Untuk alat monitoring, itu kegagalan yang paling perlu terlihat.
//
// Sengaja tanpa foreign key ke notifications, sama alasannya dengan
// EscalationDelivery: menghapus sebuah notifikasi tidak boleh menghapus jejak
// apa saja yang pernah dikirim lewatnya. Nama & tipe disalin saat kirim.
model NotificationLog {
  id                Int      @id @default(autoincrement())
  notification_id   Int?
  notification_name String
  type              String
  // monitor.down | monitor.up | monitor.cert_expiry | monitor.escalation | test
  event             String
  monitor_id        Int?
  monitor_name      String?
  ok                Boolean  @default(false)
  // Berapa percobaan yang terpakai (sendNotification mengulang dengan jeda menaik)
  attempts          Int      @default(1)
  error             String?
  duration_ms       Int?
  created_at        DateTime @default(now())

  @@index([created_at(sort: Desc)])
  @@index([notification_id, created_at(sort: Desc)])
  @@index([ok, created_at(sort: Desc)])
  @@map("notification_logs")
}

// Ringkasan harian heartbeat, diisi sebelum heartbeat lama dipangkas.
// Tanpa ini, grafik waktu respons ikut hilang bersama heartbeat-nya setelah
// HEARTBEAT_RETENTION_DAYS. Laporan SLA tidak terpengaruh karena dihitung dari
// tabel incident.
//
// p95 disimpan berdampingan dengan rata-rata: rata-rata menyembunyikan ekor,
// dan justru ekor itulah yang dirasakan pengguna.
model HeartbeatDaily {
  monitor_id  Int
  day         DateTime @db.Date
  location    String
  up          Int      @default(0)
  down        Int      @default(0)
  degraded    Int      @default(0)
  maintenance Int      @default(0)
  min_ms      Int?
  avg_ms      Int?
  p95_ms      Int?
  max_ms      Int?
  updated_at  DateTime @default(now())

  @@id([monitor_id, day, location])
  @@index([monitor_id, day(sort: Desc)])
  @@map("heartbeat_daily")
}

// --- Phase 8: lease scheduler ---

// Satu baris per lokasi, dipegang oleh proses yang sedang menjalankan check.
// Proses lain dengan lokasi sama melihat lease ini masih berlaku dan diam,
// jadi replika atau rolling deploy tidak membuat check & alert dobel.
// Lease diperpanjang berkala; bila pemegangnya mati, lease kedaluwarsa sendiri
// dan proses lain mengambil alih tanpa perlu campur tangan.
model SchedulerLease {
  location   String   @id
  holder     String   // pengenal proses: host:pid:acak
  expires_at DateTime
  updated_at DateTime @default(now())

  @@map("scheduler_leases")
}
