// Pulsewatch — PostgreSQL schema
// Nama field sengaja snake_case agar bentuk JSON API tetap sama dengan versi SQLite.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique
  password_hash       String
  role                String   @default("admin") // admin | viewer
  // Token yang diterbitkan sebelum waktu ini dianggap batal (dipakai saat ganti password)
  password_changed_at DateTime @default(now())
  created_at          DateTime @default(now())

  @@map("users")
}

model Monitor {
  id                    Int      @id @default(autoincrement())
  name                  String
  type                  String   @default("http") // http | tcp | ping | dns | push
  url                   String?
  hostname              String?
  port                  Int?
  dns_resolve_type      String?  @default("A")
  dns_expected          String?
  method                String   @default("GET")
  interval_seconds      Int      @default(60)
  timeout_seconds       Int      @default(30)
  max_retries           Int      @default(0)
  expected_status_codes String   @default("200-299")
  keyword               String?
  active                Boolean  @default(true)

  // Monitor tipe `push`: target mengirim heartbeat ke /api/push/<token>.
  // Dianggap down bila tidak ada heartbeat melewati grace period.
  push_token            String?  @unique
  push_grace_seconds    Int      @default(60)

  // Sertifikat TLS (monitor https): diisi otomatis saat check
  check_cert            Boolean   @default(true)
  cert_expires_at       DateTime?
  cert_issuer           String?
  cert_subject          String?
  cert_checked_at       DateTime?
  // Hasil validasi rantai sertifikat pada pemeriksaan terakhir
  cert_chain_valid      Boolean?
  cert_chain_error      String?
  // Ambang peringatan terkecil yang sudah dikirim (30/14/7/3) supaya tidak spam.
  // Direset ke null saat sertifikat diperbarui.
  cert_notified_threshold Int?

  // HTTP check lanjutan
  http_headers          Json?     // { "X-Api-Key": "…" } — dikirim apa adanya
  auth_type             String    @default("none") // none | basic | bearer
  // Kredensial auth disimpan terenkripsi (AES-256-GCM), bukan plaintext
  auth_secret           String?
  // Assertion terhadap body JSON: assertion_path + operator + value
  assertion_path        String?   // mis. $.status atau $.data.items[0].id
  assertion_operator    String?   // eq | ne | gt | lt | gte | lte | contains | exists
  assertion_value       String?

  // Webhook automation: dipanggil untuk memicu aksi di sistem lain
  // (restart service, buka ticket). Berbeda dari notifikasi yang sekadar memberi kabar.
  action_webhook_url     String?
  action_webhook_method  String   @default("POST") // POST | GET | PUT
  action_webhook_headers Json?
  action_on_down         Boolean  @default(true)
  action_on_recover      Boolean  @default(false)

  // Target SLO dalam persen (mis. 99.9). null = monitor ini tidak punya target,
  // uptime-nya tetap dilaporkan tapi tanpa error budget.
  slo_target            Float?

  // Dependency antar-monitor: monitor induk (mis. router/gateway di depan
  // layanan ini). Selama induk down, alert & webhook aksi monitor ini ditahan
  // supaya satu gangguan di lapisan bawah tidak membanjiri notifikasi.
  parent_id             Int?

  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt

  // Induk dihapus -> anak jadi mandiri lagi (SetNull), bukan ikut terhapus
  parent   Monitor?  @relation("MonitorDependency", fields: [parent_id], references: [id], onDelete: SetNull)
  children Monitor[] @relation("MonitorDependency")

  heartbeats    Heartbeat[]
  incidents     Incident[]
  notifications MonitorNotification[]
  status_pages  StatusPageMonitor[]
  tags          MonitorTag[]
  maintenance   MaintenanceWindow[]
  events        MonitorEvent[]
  webhook_logs  WebhookLog[]

  @@index([parent_id])
  @@map("monitors")
}

model Heartbeat {
  id            Int      @id @default(autoincrement())
  monitor_id    Int
  status        Int      // 0 down, 1 up, 2 pending
  message       String?
  response_time Int?
  important     Boolean  @default(false) // true jika status berubah up<->down
  maintenance   Boolean  @default(false) // dicatat saat monitor dalam maintenance window
  // Lokasi agen yang melakukan check. null = baris lama dari sebelum
  // multi-location; diperlakukan sama dengan lokasi primary.
  location      String?
  // Hasil body assertion (null = monitor ini tidak memakai assertion)
  assertion_ok      Boolean?
  assertion_message String?
  created_at    DateTime @default(now())

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@index([monitor_id, created_at(sort: Desc)])
  @@index([monitor_id, location, created_at(sort: Desc)])
  @@map("heartbeats")
}

model Incident {
  id          Int       @id @default(autoincrement())
  monitor_id  Int
  started_at  DateTime  @default(now())
  resolved_at DateTime?
  cause       String?
  maintenance Boolean   @default(false) // down terjadi saat maintenance
  notified    Boolean   @default(false) // alert "down" sudah terkirim
  // Alert ditahan karena monitor induk sedang down. Tetap dicatat sebagai
  // incident supaya riwayat & uptime tidak berubah, hanya alert-nya yang diam.
  suppressed       Boolean @default(false)
  suppressed_by_id Int?    // id monitor induk yang menahan, untuk ditampilkan di UI

  monitor Monitor          @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  updates IncidentUpdate[]
  events  MonitorEvent[]

  @@index([monitor_id, started_at(sort: Desc)])
  @@map("incidents")
}

// Kabar manual dari admin selama incident berlangsung — tampil di status page
// publik supaya pengguna tahu perkembangannya tanpa melihat detail teknis.
model IncidentUpdate {
  id          Int      @id @default(autoincrement())
  incident_id Int
  status      String   @default("investigating") // investigating | identified | monitoring | resolved
  message     String
  author      String?  // username penulis saat dibuat
  created_at  DateTime @default(now())

  incident Incident @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@index([incident_id, created_at(sort: Desc)])
  @@map("incident_updates")
}

// Event non-heartbeat pada timeline monitor: laporan otomasi dari sistem luar
// (Ansible/n8n lewat webhook inbound) maupun catatan manual.
model MonitorEvent {
  id          Int      @id @default(autoincrement())
  monitor_id  Int
  incident_id Int?     // incident yang sedang terbuka saat event masuk, bila ada
  kind        String   @default("automation") // automation | note
  source      String?  // mis. "ansible", "n8n"
  title       String
  message     String?
  payload     Json?    // body asli dari pemanggil, untuk penelusuran
  created_at  DateTime @default(now())

  monitor  Monitor   @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incident_id], references: [id], onDelete: SetNull)

  @@index([monitor_id, created_at(sort: Desc)])
  @@map("monitor_events")
}

// Riwayat pemanggilan webhook automation, termasuk percobaan yang gagal
model WebhookLog {
  id          Int      @id @default(autoincrement())
  monitor_id  Int
  incident_id Int?
  event       String   // down | recover
  url         String
  method      String
  attempt     Int      @default(1)
  ok          Boolean  @default(false)
  status_code Int?
  error       String?
  duration_ms Int?
  created_at  DateTime @default(now())

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@index([monitor_id, created_at(sort: Desc)])
  @@map("webhook_logs")
}

// Kunci akses programatik. Hanya hash yang disimpan; nilai aslinya
// ditampilkan sekali saat dibuat.
model ApiKey {
  id           Int       @id @default(autoincrement())
  label        String
  // SHA-256 dari kunci penuh. Kunci punya entropi 256 bit sehingga hash cepat sudah memadai.
  key_hash     String    @unique
  // Potongan awal kunci untuk ditampilkan di daftar, mis. "pw_ab12cd34"
  prefix       String
  scope        String    @default("read") // read | write
  created_by   String?
  last_used_at DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  @@index([revoked_at])
  @@map("api_keys")
}

model Notification {
  id         Int      @id @default(autoincrement())
  name       String
  type       String   // telegram | discord | email | webhook | slack | googlechat | ntfy
  config     Json     @default("{}")
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  monitors MonitorNotification[]

  @@map("notifications")
}

model MonitorNotification {
  monitor_id      Int
  notification_id Int

  monitor      Monitor      @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@id([monitor_id, notification_id])
  @@map("monitor_notifications")
}

model StatusPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String?
  published   Boolean  @default(true)

  // Kustomisasi tampilan halaman publik
  logo_url     String?
  accent_color String  @default("#38bdf8")
  theme        String  @default("dark") // dark | light | auto
  show_uptime  Boolean @default(true)
  show_bars    Boolean @default(true)
  show_incidents Boolean @default(true)
  footer_text  String?
  // Pengumuman/banner incident yang ditulis manual oleh admin
  announcement       String?
  announcement_style String  @default("info") // info | warning | critical
  // Domain khusus (opsional): halaman juga bisa dibuka lewat host ini
  custom_domain String? @unique

  created_at  DateTime @default(now())

  monitors StatusPageMonitor[]
  tags     StatusPageTag[]

  @@map("status_pages")
}

// Status page bisa memilih monitor lewat tag/group, bukan satu per satu.
// Monitor yang dipilih langsung dan lewat tag digabung.
model StatusPageTag {
  status_page_id Int
  tag_id         Int

  status_page StatusPage @relation(fields: [status_page_id], references: [id], onDelete: Cascade)
  tag         Tag        @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([status_page_id, tag_id])
  @@map("status_page_tags")
}

// Pengaturan global aplikasi (key/value) — mis. bahasa & tema default
model Setting {
  key        String   @id
  value      Json     @default("{}")
  updated_at DateTime @default(now()) @updatedAt

  @@map("settings")
}

model StatusPageMonitor {
  status_page_id Int
  monitor_id     Int
  sort_order     Int @default(0)

  status_page StatusPage @relation(fields: [status_page_id], references: [id], onDelete: Cascade)
  monitor     Monitor    @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@id([status_page_id, monitor_id])
  @@map("status_page_monitors")
}

model Tag {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  color      String   @default("#38bdf8")
  created_at DateTime @default(now())

  monitors     MonitorTag[]
  status_pages StatusPageTag[]

  @@map("tags")
}

model MonitorTag {
  monitor_id Int
  tag_id     Int

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([monitor_id, tag_id])
  @@map("monitor_tags")
}

// recurring: none | daily | weekly. Untuk recurring, start_at/end_at menentukan
// jam mulai & durasi; days_of_week (weekly) berisi "0,1,..,6" (0 = Minggu).
model MaintenanceWindow {
  id           Int      @id @default(autoincrement())
  monitor_id   Int
  title        String
  start_at     DateTime
  end_at       DateTime
  recurring    String   @default("none")
  days_of_week String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  monitor Monitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)

  @@index([monitor_id])
  @@map("maintenance_windows")
}

// Jejak perubahan konfigurasi & akses. Ditulis dari route, bukan dari trigger DB,
// supaya ikut mencatat siapa pelakunya (user login maupun API key) dan dari IP mana.
// Isinya hanya dibaca — tidak ada endpoint untuk mengubah atau menghapus satu baris.
model AuditLog {
  id          Int      @id @default(autoincrement())
  actor_id    Int?     // id user; null untuk API key atau tindakan sistem
  actor       String   // username, "apikey:<label>", atau "sistem"
  actor_type  String   @default("user") // user | apikey | system
  action      String   // mis. monitor.update, user.delete, auth.login
  entity      String   // monitor | notification | user | api_key | status_page | ...
  entity_id   Int?
  entity_name String?  // nama saat kejadian, tetap terbaca walau entitasnya dihapus
  summary     String?  // ringkasan sebaris untuk daftar
  // { field: { from, to } } — nilai rahasia sudah ditopeng sebelum disimpan
  changes     Json?
  ip          String?
  created_at  DateTime @default(now())

  @@index([created_at(sort: Desc)])
  @@index([entity, entity_id, created_at(sort: Desc)])
  @@index([actor, created_at(sort: Desc)])
  @@map("audit_logs")
}
